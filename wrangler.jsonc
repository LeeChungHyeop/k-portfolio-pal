{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // 예정된 시세 갱신. **분/시 필드는 UTC** 이므로 한국시간(KST=UTC+9) 평일
  // 09:00~14:50 / 15:00~15:40 을 10분 간격으로 도는 설정이다.
  // 15:40(UTC 06:40) 조회값이 장 마감 이후 최종 종가 캐시 역할도 하고,
  // 그 슬롯에서만 일별 자산 스냅샷을 쓴다(src/server.ts isDailySnapshotSlot).
  //
  // 요일은 **반드시 MON-FRI 이름으로 적는다.** Cloudflare 의 day-of-week 는 1-7 이고
  // **1 = 일요일**이라서, 숫자 `1-5` 는 월~금이 아니라 **일~목**이다. 실제로 그 설정에서
  // 금요일 슬롯이 한 번도 돌지 않아 금요일 종가 캐시와 스냅샷이 빠졌다(일요일만 적재됨).
  "triggers": {
    "crons": [
      "*/10 0-5 * * MON-FRI",
      "0,10,20,30,40 6 * * MON-FRI"
    ]
  },
  // Workers Logs — cron 이 돌았는지/스냅샷이 왜 건너뛰어졌는지를 사후에 조회하려면 필요하다.
  // 꺼져 있던 동안에는 과거 cron 의 skip/fail 사유를 전혀 확인할 수 없었다.
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    { "binding": "RATE_LIMIT", "id": "3cd53d1c06d8473990d4f71a7fcfd45f" }
  ],
}
